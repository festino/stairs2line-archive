{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/stairs2line/archive-source.schema.json",
  "title": "stairs2line archive source",
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "default": {
          "type": "string"
        }
      }
    },
    "media": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "legacyIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "viewerAnchor": {
          "description": "Optional two-point image registration in reference-file pixel coordinates, used only when comparing media across versions of one artwork in MediaViewer.",
          "type": "object",
          "required": [
            "points"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "description": "Optional declared file whose pixel coordinate system is used. If omitted, the first declared existing image with known dimensions is used."
            },
            "flipX": {
              "type": "boolean",
              "description": "Optional horizontal mirror applied before rotation. Omitted means false."
            },
            "rotation": {
              "type": "number",
              "description": "Optional clockwise rotation in degrees applied after flipX. Omitted means 0."
            },
            "points": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "version": {
      "type": "object",
      "required": [
        "id",
        "scope",
        "media"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "top",
            "major",
            "sketchy",
            "decorative"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "knownNotAfter": {
          "type": "string",
          "oneOf": [
            {
              "format": "date"
            },
            {
              "format": "date-time"
            }
          ]
        },
        "media": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/media"
          }
        },
        "migration": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "artwork": {
      "type": "object",
      "required": [
        "id",
        "versions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/version"
          }
        },
        "migration": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "platformVersion": {
      "type": "object",
      "properties": {
        "observedAt": {
          "type": "string",
          "oneOf": [
            {
              "format": "date"
            },
            {
              "format": "date-time"
            }
          ]
        },
        "account": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "avatar": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "banner": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "required": [
        "id",
        "label",
        "versions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "$ref": "#/$defs/localizedText"
        },
        "defaultAccount": {
          "description": "Stable URL-template fallback. Display/profile account belongs in versions[].account.",
          "type": "string",
          "minLength": 1
        },
        "postUrlTemplate": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "description": "Known creation date of the profile/blog. Date-only values are allowed when the exact time is not known.",
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "integer"
            }
          ]
        },
        "createdBefore": {
          "description": "Legacy approximate upper bound for profile/blog creation. Prefer createdAt + dateApproximate for new data.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ]
        },
        "dateApproximate": {
          "type": "boolean",
          "description": "When true, createdAt is approximate. Uses the same presentation convention as approximate post dates."
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/platformVersion"
          }
        }
      },
      "additionalProperties": false
    },
    "postLayoutRow": {
      "type": "object",
      "required": [
        "blocks"
      ],
      "properties": {
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "postLayout": {
      "type": "object",
      "required": [
        "type",
        "display"
      ],
      "properties": {
        "type": {
          "const": "rows"
        },
        "display": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/postLayoutRow"
          }
        }
      },
      "additionalProperties": false
    },
    "postReblog": {
      "type": "object",
      "required": [
        "blog",
        "id"
      ],
      "properties": {
        "blog": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "postVersion": {
      "type": "object",
      "properties": {
        "account": {
          "type": "string"
        },
        "status": {
          "description": "Legacy compatibility only. Canonical v2.3 source stores availability of the original post in post.status, not in individual versions.",
          "enum": [
            "alive",
            "deleted"
          ]
        },
        "href": {
          "type": "string",
          "format": "uri"
        },
        "originalLanguage": {
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "media": {
          "description": "Physical file-path lookup keys. Each path identifies a logical artwork media item; rendering may use a smaller equivalent file from that media item.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "layout": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/postLayout"
          }
        },
        "migration": {
          "type": "object"
        },
        "firstRebloggedAt": {
          "description": "Earliest known timestamp of a reblog preserving this version. null means no reblog observation is available.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reblogs": {
          "description": "Known live Tumblr reblogs preserving this version. Source stores only blog nickname and reblog post id; the URL is reconstructed at build time.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/postReblog"
          }
        }
      },
      "additionalProperties": false
    },
    "post": {
      "type": "object",
      "required": [
        "platform",
        "id",
        "versions"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/postVersion"
          }
        },
        "status": {
          "description": "Availability of the original post itself. Version snapshots do not have independent alive/deleted status.",
          "enum": [
            "alive",
            "deleted"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "artworks"
      ],
      "properties": {
        "artworks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artwork"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "posts"
      ],
      "properties": {
        "posts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/post"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "platforms"
      ],
      "properties": {
        "platforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/platform"
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
