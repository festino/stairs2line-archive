{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/stairs2line/archive-source.schema.json",
  "title": "stairs2line archive source",
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "properties": {
        "default": { "type": "string" }
      }
    },
    "media": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "legacyIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "version": {
      "type": "object",
      "required": ["id", "scope", "media"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope": {
          "enum": ["top", "major", "sketchy", "decorative"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "knownNotAfter": {
          "type": "string",
          "oneOf": [
            { "format": "date" },
            { "format": "date-time" }
          ]
        },
        "media": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/media" }
        },
        "migration": { "type": "object" }
      },
      "additionalProperties": false
    },
    "artwork": {
      "type": "object",
      "required": ["id", "versions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "title": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/version" }
        },
        "migration": { "type": "object" }
      },
      "additionalProperties": false
    },
    "post": {
      "type": "object",
      "required": ["platform", "id", "status"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "account": { "type": "string" },
        "status": { "enum": ["alive", "deleted"] },
        "publishedAt": { "type": "string", "format": "date-time" },
        "href": { "type": "string", "format": "uri" },
        "originalLanguage": { "type": "string" },
        "title": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "media": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "legacyAutoLink": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["artworks"],
      "properties": {
        "artworks": {
          "type": "array",
          "items": { "$ref": "#/$defs/artwork" }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["posts"],
      "properties": {
        "posts": {
          "type": "array",
          "items": { "$ref": "#/$defs/post" }
        }
      },
      "additionalProperties": false
    }
  ]
}
